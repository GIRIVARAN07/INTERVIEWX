# MongoDB Atlas connection string
# Replace <username>, <password>, and <cluster-url> with your actual values
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/interviewx?retryWrites=true&w=majority

# JWT Secret — use any random string (keep it secret!)
JWT_SECRET=your_super_secret_jwt_key_change_this

# Server port
PORT=5000
